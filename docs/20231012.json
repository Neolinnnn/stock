el":"矽格主要提供專業半導體委外封裝與測試服務 (OSAT)，採B2B模式，專注於晶片的量產驗證與品質把關，不經營自有品牌產品。","moat":"矽格的核心競爭優勢包括在射頻IC及電源管理IC測試領域的利基市場領導地位與高技術門檻。公司具備AI、HPC及矽光子等先進測試技術的自主研發能力，並持續投入高階測試設備與智慧製造。與聯發科等一線大廠建立了穩固的長期合作關係，訂單來源穩定，並成功導入美系ASIC與CPO新客戶。此外，透過積極的產能擴張（如新建中興三廠及湖口二廠）及資本支出大幅上修，以滿足AI、HPC及CPO等高成長市場的需求。公司能提供從晶圓測試到成品測試的完整封測解決方案。","summary":"矽格（6257）作為台灣半導體封裝與測試（OSAT）領導廠商，2026年第一季營運表現穩健，營收創同期新高，獲利年增近33%。公司積極佈局AI、HPC、ASIC、矽光子(CPO)及網通等高階先進製程測試領域，並獲得新客戶訂單，預期相關高階產品線營收比重將持續提升。目前已掌握多家國內外知名IC設計大廠客戶，其中聯發科為最大客戶。鑒於公開資訊未提供2026年最新各產品線營收比例及年增率細項，產品線比例為根據2024年應用領域分佈及近期成長趨勢所做的合理估計；地區別營收分佈的最新資料則未能取得。","data_period":"2026 Q1","updated_at":"2026-06-22"}},{"sector":"CoPoS封裝","id":"3583","name":"辛耘","price":207.0,"rsi":59.0,"cv_sharpe":2.73,"bias_ma10":null,"sector_strong":null,"trend_analysis":{"code":"3583","trend_status":"多頭排列","ma_alignment":"多頭排列 MA5>MA10>MA20","trend_strength":75,"ma5":741.2,"ma10":722.2,"ma20":709.15,"ma60":717.38,"current_price":736.0,"bias_ma5":-0.7,"bias_ma10":1.91,"bias_ma20":3.79,"volume_status":"縮量回調","volume_ratio_5d":0.49,"volume_trend":"縮量回調，洗盤特徵明顯（佳）","support_ma5":false,"support_ma10":true,"buy_signal":"強力買入","signal_score":99,"signal_reasons":["多頭排列，順勢做多","價格略低於MA5(-0.7%)，回踩買點","縮量回調，主力洗盤","MA10支撐有效","MACD 中性區域","RSI中性(55.4)，震盪整理中","強勢族群加持，資金輪動有利","CV夏普=2.73（普通）"],"risk_factors":[],"macd_dif":5.7091,"macd_dea":-0.4929,"macd_bar":12.4041,"macd_status":"多頭","macd_signal":"MACD 中性區域","rsi_6":57.5,"rsi_12":55.4,"rsi_24":51.2,"rsi_status":"中性","rsi_signal":"RSI中性(55.4)，震盪整理中","sector_is_strong":true,"kd_k":63.62,"kd_d":62.81,"kd_j":65.26,"kd_k_prev":67.72,"kd_d_prev":62.4,"macd_bar_prev":7.09,"entry_strategy":{"vol_ratio":0.71,"vol_ok":false,"macd_momentum":false,"passed":false,"grade":"C"}},"product_mix":{"product_lines":[{"name":"自製裝置","share_pct":41.91,"yoy_growth":93,"trend":"up"},{"name":"代理事業","share_pct":48.37,"yoy_growth":null,"trend":"down"},{"name":"晶圓再生","share_pct":9.73,"yoy_growth":null,"trend":"up"}],"regions":[],"customers":["台積電","聯電","力積電","京東方","友達"],"biz_model":"公司採用「混合